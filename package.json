{
  "name": "runeterra-doudizhu",
  "version": "1.0.0",
  "private": true,
  "description": "符文之地斗地主 React 单机原型",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.config.{js,ts}\" \"scripts/**/*.mjs\" --max-warnings 0",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"src/domain/__tests__/quality.simulation.test.ts\"",
    "test:watch": "vitest",
    "test:ui": "playwright test tests/e2e/app.spec.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:budget": "node scripts/check-budgets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "build": "npm run typecheck && vite build",
    "build:release": "npm run build && npm run test:budget",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.1.0",
    "vitest": "^4.0.8"
  }
}
